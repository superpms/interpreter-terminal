{
    "name": "superpms/interpreter-terminal",
    "license": "Apache-2.0",
    "description": "pms terminal interpreter",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "files": [
            "bin/autoload.php"
        ],
        "psr-4": {
            "pms\\": "src/pms/"
        }
    },
    "authors": [
        {
            "name": "Guest",
            "email": "kid666@88.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "superpms/basic": "^1.0.0"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "pms": {
            "config":{
                "command": "resource/config.php"
            }
        }
    }
}
